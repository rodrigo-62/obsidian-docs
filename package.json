{
	"name": "obsidian-docs",
	"version": "0.1.0",
	"private": true,
	"description": "Docs: Google-Docs-like doc mode for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"vault:reset": "node scripts/build-test-vault.mjs",
		"install-plugin": "node scripts/install-plugin.mjs",
		"update-vaults": "npm run build && node scripts/update-vaults.mjs"
	},
	"license": "UNLICENSED",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"happy-dom": "^21.0.4",
		"obsidian": "^1.14.4",
		"tslib": "^2.9.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
